<%- include('../parciales/cabecera') %>
<%- include('../parciales/errores', { errores: Object.values(errores) }) %>

<form method="post" action="/registro">
  <label for="nombre">Nombre</label>
  <input id="nombre" name="nombre" value="<%= valores.nombre %>" required>

  <label for="email">Correo</label>
  <input id="email" name="email" type="email" value="<%= valores.email %>" required>

  <label for="password">Contraseña (mínimo 8 caracteres)</label>
  <input id="password" name="password" type="password" required>

  <button type="submit">Crear cuenta</button>
</form>
<%- include('../parciales/pie') %>
